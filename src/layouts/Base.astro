---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  active?: string;
  preloadHero?: boolean;
}

const { title, description, active, preloadHero = false } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {preloadHero && <link rel="preload" as="image" href="/images/hero.jpg" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Mobile nav
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        nav.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') nav.classList.remove('open');
        });
      }

      // Route selector tabs
      const tablist = document.querySelector('.route-tabs');
      if (tablist) {
        const tabs = tablist.querySelectorAll<HTMLButtonElement>('button');
        const panels = document.querySelectorAll<HTMLElement>('.route-panel');
        tabs.forEach((btn) => {
          btn.addEventListener('click', () => {
            tabs.forEach((b) => b.setAttribute('aria-selected', 'false'));
            panels.forEach((p) => p.classList.remove('active'));
            btn.setAttribute('aria-selected', 'true');
            const id = btn.getAttribute('aria-controls');
            if (id) document.getElementById(id)?.classList.add('active');
          });
        });
      }

      // Current year
      document.querySelectorAll('[data-year]').forEach((el) => {
        el.textContent = String(new Date().getFullYear());
      });
    </script>
  </body>
</html>
