---
import { localeUrlSafe, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
  crumb: string;
  title: string;
  lead: string;
  locale?: Locale;
}
const { crumb, title, lead, locale = 'ja' } = Astro.props;
const ui = getUi(locale);
const homeHref = localeUrlSafe('', locale);
---
<section class="pagehead">
  <div class="wrap">
    <p class="crumbs"><a href={homeHref}>{ui.homeCrumb}</a> / {crumb}</p>
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
</section>
