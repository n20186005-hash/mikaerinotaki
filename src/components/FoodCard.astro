---
import type { FoodPlace } from '../data/food';
import { L } from '../i18n/types';
import type { Locale } from '../i18n/config';

interface Props {
  place: FoodPlace;
  locale?: Locale;
}
const { place, locale = 'ja' } = Astro.props;
---
<div class="food">
  <div class="food__pic">
    <span class="badge">{L(place.badge, locale)}</span>
    <span class="kanji">{place.kanji}</span>
  </div>
  <div class="food__body">
    <h3>{L(place.name, locale)}</h3>
    <p class="sub">{L(place.sub, locale)}</p>
    <p>{L(place.desc, locale)}</p>
    <div class="food__meta">
      {place.pills.map((p) => <span class={`pill${p.warn ? ' warn' : ''}`}>{L(p.text, locale)}</span>)}
    </div>
  </div>
</div>
