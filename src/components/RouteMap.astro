---
import { L, type Localized } from '../i18n/types';
import type { Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = (o: Localized) => L(o, locale);
---
<div class="map-frame">
  <svg viewBox="0 0 760 540" role="img" aria-label={t({ ja: '見帰りの滝 散策マップ模式図', en: 'Mikaeri No Taki walking-map schematic', 'zh-Hant': '見歸里之瀧散步地圖示意圖' })}>
    <defs>
      <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#b9cfe0" />
        <stop offset="1" stop-color="#728AA8" />
      </linearGradient>
    </defs>
    <rect x="0" y="0" width="760" height="540" fill="#eef2ee" />
    <path d="M0,0 H300 C260,120 170,180 120,300 C80,400 40,460 0,520 Z" fill="#dfe8df" />
    <path d="M760,0 H470 C520,130 600,200 650,320 C690,420 730,470 760,520 Z" fill="#dfe8df" />
    <path d="M300,0 H470 C450,90 470,150 430,230 C400,300 360,300 340,230 C305,150 320,90 300,0 Z" fill="#d3e0d2" />
    <path
      d="M383,30 C381,90 375,120 378,170 C382,240 350,270 360,330 C368,388 340,430 352,500"
      fill="none"
      stroke="url(#water)"
      stroke-width="16"
      stroke-linecap="round"
    />
    <g stroke="#ffffff" stroke-width="2" opacity=".9">
      <line x1="378" y1="34" x2="376" y2="150" />
      <line x1="386" y1="34" x2="384" y2="150" />
    </g>
    <path
      d="M352,505 C300,470 300,420 330,370 C360,320 300,300 320,250 C338,205 360,200 372,160"
      fill="none"
      stroke="#183B34"
      stroke-width="3"
      stroke-dasharray="2 9"
      stroke-linecap="round"
    />
    <rect x="330" y="322" width="60" height="12" rx="3" fill="#CFC3AE" stroke="#a9987a" />
    <g fill="#8B769C" opacity=".85">
      <circle cx="300" cy="360" r="6" /><circle cx="312" cy="352" r="6" /><circle cx="292" cy="350" r="6" />
      <circle cx="416" cy="300" r="6" /><circle cx="428" cy="292" r="6" /><circle cx="408" cy="290" r="6" />
      <circle cx="322" cy="410" r="6" /><circle cx="334" cy="402" r="6" />
    </g>
    <g font-family="Inter, sans-serif" font-size="13" font-weight="600">
      <g>
        <circle cx="381" cy="30" r="9" fill="#183B34" />
        <text x="395" y="27" fill="#183B34">{t({ ja: '滝', en: 'Falls', 'zh-Hant': '瀑布' })}</text>
        <text x="395" y="43" fill="#5a6460" font-size="11" font-weight="400">{t({ ja: '正面・展望', en: 'Front view', 'zh-Hant': '正面・展望' })}</text>
      </g>
      <g><circle cx="376" cy="150" r="9" fill="#728AA8" /><text x="392" y="154" fill="#183B34">{t({ ja: '滝つぼ近くの観瀑点', en: 'Pool-side viewpoint', 'zh-Hant': '瀑潭附近觀瀑點' })}</text></g>
      <g><circle cx="360" cy="330" r="9" fill="#728AA8" /><text x="404" y="334" fill="#183B34">{t({ ja: '橋からの眺め・蛍橋', en: 'View from bridge', 'zh-Hant': '橋上眺望・螢橋' })}</text></g>
      <g><circle cx="322" cy="410" r="9" fill="#8B769C" /><text x="150" y="414" fill="#183B34" text-anchor="end">{t({ ja: 'あじさい群生', en: 'Hydrangea beds', 'zh-Hant': '繡球花群' })}</text></g>
      <g><circle cx="352" cy="505" r="9" fill="#183B34" /><text x="368" y="509" fill="#183B34">{t({ ja: '遊歩道入口', en: 'Trail entrance', 'zh-Hant': '步道入口' })}</text></g>
      <g>
        <rect x="440" y="470" width="22" height="22" rx="4" fill="#CFC3AE" stroke="#a9987a" />
        <text x="451" y="486" fill="#183B34" text-anchor="middle" font-size="13">P</text>
        <text x="470" y="486" fill="#183B34" font-size="13">{t({ ja: '蛍橋駐車場', en: 'Hotaribashi parking', 'zh-Hant': '螢橋停車場' })}</text>
      </g>
      <g>
        <circle cx="300" cy="470" r="9" fill="#5a6460" />
        <text x="300" y="474" fill="#fff" text-anchor="middle" font-size="10">WC</text>
        <text x="150" y="474" fill="#183B34" text-anchor="end">{t({ ja: 'トイレ', en: 'Toilet', 'zh-Hant': '廁所' })}</text>
      </g>
    </g>
  </svg>
</div>
<div class="legend">
  <span><i style="background:#728AA8"></i>{t({ ja: '川・滝', en: 'River / falls', 'zh-Hant': '河・瀑布' })}</span>
  <span><i style="background:#183B34"></i>{t({ ja: '観瀑・展望ポイント', en: 'Viewpoints', 'zh-Hant': '觀瀑・展望點' })}</span>
  <span><i style="background:#8B769C"></i>{t({ ja: 'あじさい群生', en: 'Hydrangea beds', 'zh-Hant': '繡球花群' })}</span>
  <span><i style="background:#CFC3AE;border:1px solid #a9987a"></i>{t({ ja: '駐車場(P)', en: 'Parking (P)', 'zh-Hant': '停車場(P)' })}</span>
  <span><i style="background:#5a6460"></i>{t({ ja: 'トイレ(WC)', en: 'Toilet (WC)', 'zh-Hant': '廁所(WC)' })}</span>
  <span><i style="background:repeating-linear-gradient(90deg,#183B34 0 2px,transparent 2px 6px)"></i>{t({ ja: '遊歩道', en: 'Trail', 'zh-Hant': '步道' })}</span>
</div>
