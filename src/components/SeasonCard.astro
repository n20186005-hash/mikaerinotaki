---
import type { Season } from '../data/seasons';
import { L, type Localized } from '../i18n/types';
import type { Locale } from '../i18n/config';

interface Props {
  season: Season;
  locale?: Locale;
}
const { season, locale = 'ja' } = Astro.props;
const t = (o: Localized) => L(o, locale);
---
<article class="season-card">
  <div class="media"><img src={season.img} alt={`${t(season.name)}の${t(season.sub)}`} width="760" height="500" loading="lazy" decoding="async" /></div>
  <div class="body">
    <p class="when">{season.when}</p>
    <h3>{t(season.name)} <span>{t(season.sub)}</span></h3>
    <p class="short">{t(season.short)}</p>
    <span class="chip">{t(season.chip)}</span>
    <dl class="facts">
      {
        season.meta.map((m) => (
          <div class="row"><dt>{t(m.k)}</dt><dd>{t(m.v)}</dd></div>
        ))
      }
    </dl>
  </div>
</article>
