---
import { entity } from '../data/entity';
import { reviews } from '../data/reviews';
import { sources } from '../data/sources';
import { L, type Localized } from '../i18n/types';
import type { Locale } from '../i18n/config';

interface Props {
  id?: string;
  locale?: Locale;
}
const { id = 'sources', locale = 'ja' } = Astro.props;
const t = (o: Localized) => L(o, locale);
---

<section class="section" id={id}>
  <div class="wrap">
    <p class="eyebrow">Sources</p>
    <h2 class="section-title">
      {t({ ja: '情報源とクレジット', en: 'Sources & credits', 'zh-Hant': '資訊來源與致謝' })}<span class="h2-en">Sources &amp; references for {entity.fullNameEn}</span>
    </h2>
    <p class="section-lead" style="margin-bottom:26px">
      {t({ ja: '掲載内容は以下の公的機関・地域観光団体・百科事典の情報をもとに編集しています。季節・開花・交通規制は変更される場合があるため、お出かけ前に一次情報もご確認ください。', en: 'Content is edited from the public bodies, tourism associations and encyclopedias below. Seasons, blooms and traffic control can change — check primary sources before visiting.', 'zh-Hant': '內容根據下列官方機構、觀光協會與百科全書編輯。季節、開花與交通管制可能變動，出發前請也查一次資訊。' })}
    </p>

    <ol class="src-list">
      {
        sources.map((s) => (
          <li class="src-item">
            <div class="src-kind">{t(s.kind)}</div>
            <div class="src-body">
              <p class="src-name">
                <a href={s.url} target="_blank" rel="noopener noreferrer">{t(s.name)}</a>
              </p>
              <p class="src-usage">{t(s.usage)}</p>
              {s.syncedAt && <p class="src-sync">{t(reviews.sourcesEntryLabel)} · {t({ ja: '同期', en: 'synced', 'zh-Hant': '同步' })} {s.syncedAt}</p>}
              {s.note && <p class="src-note">{t(s.note)}</p>}
              {s.syncedAt && (
                <p class="src-note">
                  <a href={s.url} target="_blank" rel="noopener noreferrer">{t(reviews.syncLineLink)}</a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="notice" style="margin-top:26px">
      <strong>{t({ ja: 'ご注意：', en: 'Note: ', 'zh-Hant': '注意：' })}</strong>{t({ ja: `本サイトは${entity.fullName}（${entity.fullNameEn}）を紹介する独立した旅行ガイドです。${entity.city}・${entity.state}の公式サイトではありません。`, en: `This is an independent travel guide to ${entity.fullNameEn}. It is not the official site of ${entity.cityEn}, ${entity.stateEn}.`, 'zh-Hant': `本站是介紹${entity.fullName}（${entity.fullNameEn}）的獨立旅行指南，並非${entity.city}・${entity.state}的官方網站。` })}
      {t({ ja: '評価と評価件数は', en: 'Ratings and counts quote ', 'zh-Hant': '評分與評價數引用' })}
      {t(reviews.sourceName)}{t({ ja: 'のユーザー評価を引用したもので、最新の数値は', en: ' user reviews; for the latest figures see ', 'zh-Hant': '的使用者評價，最新數值請見' })}
      <a href={reviews.allReviewsUrl} target="_blank" rel="noopener noreferrer">{t({ ja: 'Google マップ', en: 'Google Maps', 'zh-Hant': 'Google 地圖' })}</a>
      {t({ ja: 'にてご確認ください。', en: '.', 'zh-Hant': '。' })}
    </div>

    <p style="margin-top:22px">
      For official updates and regional tourism information, visit
      <a href={entity.govtTourismUrl} target="_blank" rel="noopener noreferrer">
        {entity.countryEn} / {entity.stateEn} Official Tourism Portal </a>.
    </p>
  </div>
</section>
