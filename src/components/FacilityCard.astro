---
import type { FacilityGroup } from '../data/facilities';

interface Props {
  group: FacilityGroup;
  /** true のときは項目を折りたたまず全件表示 */
  detailed?: boolean;
}
const { group, detailed = false } = Astro.props;
const items = detailed ? group.items : group.items.slice(0, 3);
---

<article class="card facility">
  <div class="facility__head">
    <span class="facility__icon" aria-hidden="true">{group.icon}</span>
    <h3>{group.title}</h3>
  </div>
  <p class="facility__lead">{group.lead}</p>
  <dl class="facility__list">
    {items.map((i) => (
      <div class="facility__row">
        <dt>{i.label}</dt>
        <dd>{i.body}</dd>
      </div>
    ))}
  </dl>
  {group.caution && <p class="facility__caution">※ {group.caution}</p>}
  {!detailed && group.items.length > items.length && (
    <p class="facility__more"><a href="/facilities">詳しく見る →</a></p>
  )}
</article>
