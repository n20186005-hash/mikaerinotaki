---
import type { FacilityGroup } from '../data/facilities';
import { L, type Localized } from '../i18n/types';
import type { Locale } from '../i18n/config';

interface Props {
  group: FacilityGroup;
  locale?: Locale;
}
const { group, locale = 'ja' } = Astro.props;
const t = (o: Localized) => L(o, locale);
---
<section class="facility" id={group.id}>
  <h2><span class="ico" aria-hidden="true">{group.icon}</span>{t(group.title)}</h2>
  <p class="lead">{t(group.lead)}</p>
  <div class="item">
    {
      group.items.map((it) => (
        <div class="fc">
          <h3>{t(it.label)}</h3>
          <p>{t(it.body)}</p>
        </div>
      ))
    }
  </div>
  {group.caution && <p class="caution">{t(group.caution)}</p>}
</section>
