  <!-- FOOD -->
  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Local food</p>
      <h2 class="section-title">{t({ ja: '滝のあとに味わう、相知の味', en: 'Arito flavours after the falls', 'zh-Hant': '瀑布之後，品嚐相知之味' })}</h2>
      <p class="section-lead" style="margin-bottom:30px">{t({ ja: '滝の周辺は飲食店が多くありません。だからこそ、確かめて選んだ滝周辺のお店と、唐津まで足を延ばす“ついでグルメ”を分けてご案内します。', en: 'Few eateries right by the falls. So we split vetted spots near the falls from “detour gourmet” out toward Karatsu.', 'zh-Hant': '瀑布周邊餐飲不多，因此我們把勘察過的瀑布附近店家，與延伸到唐津的「順遊美食」分開介紹。' })}</p>
      <div class="grid grid-2">
        <div class="card"><h3>{t({ ja: '滝のすぐそば', en: 'Right by the falls', 'zh-Hant': '瀑布正旁' })}</h3><p>{t({ ja: '渓谷沿いの宿でいただく、相知の川魚料理。歩いたあとの一食にふさわしい、この土地ならではの味です。訪問前の電話確認がおすすめです。', en: 'River-fish dishes at inns along the gorge — a local taste fit for a meal after walking. Call ahead before visiting.', 'zh-Hant': '溪谷沿岸旅館的相知川魚料理，是散步後合適的在地之味，建議前往前先電話確認。' })}</p></div>
        <div class="card"><h3>{t({ ja: '唐津まで足をのばして', en: 'Out to Karatsu', 'zh-Hant': '延伸到唐津' })}</h3><p>{t({ ja: '呼子のイカ、佐賀牛、唐津バーガー、唐津茶。滝の帰り道に立ち寄れる、唐津エリアを代表するグルメです。', en: 'Yobuko squid, Saga beef, Karatsu burger, Karatsu tea — representative Karatsu-area gourmet on the way home.', 'zh-Hant': '呼子烏賊、佐賀牛、唐津漢堡、唐津茶，是返程可順遊的唐津代表美食。' })}</p></div>
      </div>
      <div style="margin-top:24px"><a class="btn btn--outline" href={localeUrlSafe('/food', locale)}>{t({ ja: '周辺グルメを見る →', en: 'See local food →', 'zh-Hant': '查看周邊美食 →' })}</a></div>
    </div>
  </section>

  <!-- COURSES -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Model courses</p>
      <h2 class="section-title">
        {t({ ja: '半日・一日のモデルコース', en: 'Half- & full-day courses', 'zh-Hant': '半日・一日行程' })}<span class="h2-en">{t({ ja: `Landmarks & Attractions Around ${entity.shortName}`, en: `Landmarks & Attractions Around ${entity.shortName}`, 'zh-Hant': `Landmarks & Attractions Around ${entity.shortName}` })}</span>
      </h2>
      <p class="section-lead" style="margin-bottom:30px">
        {t({ ja: `滝だけなら1〜2時間。周辺とつなげば、相知・厳木・唐津をめぐる充実した一日になります。${entity.fullName}を訪れる際は、周辺の史跡や自然景観——`, en: `Just the falls is 1–2 hours. Tie in the surroundings for a full day around Arito, Kishima and Karatsu. When visiting ${entity.fullNameEn}, also tour nearby historic sites and scenery —`, 'zh-Hant': `只看瀑布約1〜2小時。結合周邊就是暢遊相知、嚴木、唐津的充實一日。造訪${entity.fullName}時，也可一併巡遊周邊史跡與自然景觀——` })}<strong>{entity.nearbyLandmark1}</strong>{t({ ja: 'や', en: ' and ', 'zh-Hant': '與' })}<strong>{entity.nearbyLandmark2}</strong>{t({ ja: '——もあわせて巡ることができます。', en: '.', 'zh-Hant': '——。' })}
      </p>
      <div class="grid grid-2">
        {courses.map((c) => (
          <div class="card"><h3>{c.letter} ｜ {t(c.title)}</h3><p>{c.steps.map((s) => t(s)).join(' → ')}</p></div>
        ))}
      </div>
      <div style="margin-top:24px"><a class="btn btn--outline" href={localeUrlSafe('/nearby', locale)}>{t({ ja: 'モデルコースの詳細 →', en: 'Course details →', 'zh-Hant': '行程詳細 →' })}</a></div>
    </div>
  </section>

  <!-- FACILITIES -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Facilities</p>
      <h2 class="section-title">
        {t({ ja: '訪客サービスと周辺施設', en: 'Facilities & services', 'zh-Hant': '訪客設施與周邊' })}<span class="h2-en">{t({ ja: `Facilities & services near ${entity.fullNameEn}`, en: `Facilities & services near ${entity.fullNameEn}`, 'zh-Hant': `Facilities & services near ${entity.fullNameEn}` })}</span>
      </h2>
      <p class="section-lead" style="margin-bottom:26px">
        {t({ ja: 'トイレ・駐車場・飲食・宿泊・買い物・給油やEV充電まで。種類ごとに中立的にまとめています（当サイトは特定の店舗を紹介しません）。', en: 'Toilets, parking, food, stays, shopping, fuel and EV charging — summarised neutrally by type (we recommend no specific shop).', 'zh-Hant': '廁所、停車、餐飲、住宿、購物、加油與EV充電，按類型中立整理（本站不推薦特定店家）。' })}
      </p>
      <div class="grid grid-3">
        {facilityGroups.slice(0, 3).map((g) => <FacilityCard group={g} locale={locale} />)}
      </div>
      <div style="margin-top:24px"><a class="btn btn--outline" href={localeUrlSafe('/facilities', locale)}>{t({ ja: '施設・サービスの一覧 →', en: 'All facilities & services →', 'zh-Hant': '設施與服務一覽 →' })}</a></div>
    </div>
  </section>

  <!-- TIPS -->
  <section class="section alt">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">Before you go</p>
          <h2 class="section-title">{t({ ja: '雨の日と、安全のこと', en: 'Rainy days & safety', 'zh-Hant': '雨天與安全' })}</h2>
          <p class="section-lead">{t({ ja: '雨は「行かない理由」ではありません。曇りや小雨の日はあじさいの色がやわらく、渓谷に霧が立ちます。ただし足元は滑りやすくなります。', en: 'Rain is not a reason to skip. On cloudy or light-rain days the hydrangea colours soften and mist rises in the gorge — but footing gets slippery.', 'zh-Hant': '雨不是「不去了」的理由。陰天或細雨時繡球花色澤柔和、溪谷起霧，但腳下會變濕滑。' })}</p>
          <ul class="checklist" style="margin-top:20px">
            <li>{t({ ja: '石段・濡れた岩は滑りやすい。滑りにくい靴で', en: 'Stone steps & wet rock are slippery — wear grippy shoes', 'zh-Hant': '石階與濕岩易滑，穿止滑鞋' })}</li>
            <li>{t({ ja: 'ベビーカーは段差が多く、抱っこ紐が安心', en: 'Many steps with a stroller — a carrier is safer', 'zh-Hant': '推嬰兒車落差多，背帶更安心' })}</li>
            <li>{t({ ja: '水しぶきの近くではカメラ・スマホの防水を', en: 'Waterproof your camera/phone near the spray', 'zh-Hant': '水花附近請為相機手機防水' })}</li>
            <li>{t({ ja: '夏は虫よけ、夕方以降は羽織るものを', en: 'Repellent in summer; a layer from evening on', 'zh-Hant': '夏天防蚊，傍晚後加件薄衣' })}</li>
            <li>{t({ ja: '川の増水時は無理に近づかない', en: 'Don’t approach when the river is swollen', 'zh-Hant': '河水漲時勿勉強靠近' })}</li>
          </ul>
        </div>
        <div class="split__media"><img src="/images/falls.jpg" alt={t({ ja: '岩壁を流れ落ちる見帰りの滝の全景', en: 'Full view of Mikaeri No Taki down the rock face', 'zh-Hant': '沿岩壁傾瀉的見歸里之瀧全景' })} loading="lazy" /></div>
      </div>
    </div>
  </section>

