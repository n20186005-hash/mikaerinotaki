            <dt>{t({ ja: '座標', en: 'Coordinates', 'zh-Hant': '座標' })}</dt>
            <dd class="en">N {entity.latitude} / E {entity.longitude}</dd>
            <dt>{t({ ja: 'アクセス', en: 'Access', 'zh-Hant': '交通' })}</dt>
            <dd>{t({ ja: '唐津ICから約10km・18分。JR唐津線「相知駅」からタクシーで約7〜8分。', en: '~10 km / 18 min from Karatsu IC; ~7–8 min by taxi from Arito Station (JR Karatsu Line).', 'zh-Hant': '唐津IC約10km・18分，JR唐津線「相知站」轉計程車約7〜8分。' })}</dd>
