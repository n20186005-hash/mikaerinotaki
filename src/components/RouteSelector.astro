---
import { routes } from '../data/routes';
---
<div class="route-tabs" role="tablist" aria-label="滞在時間">
  {
    routes.map((r, i) => (
      <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={r.id} id={`t-${r.id}`}>
        {r.tab}
      </button>
    ))
  }
</div>
{
  routes.map((r, i) => (
    <div class={`route-panel${i === 0 ? ' active' : ''}`} id={r.id} role="tabpanel" aria-labelledby={`t-${r.id}`}>
      <div class="route-card">
        <div>
          <span class="scard when">{r.tag}</span>
          <h3>{r.title}</h3>
          <p style="color:rgba(41,49,46,.82);font-size:.93rem">{r.desc}</p>
          <div class="route-meta">
            {r.meta.map((m) => (
              <div>
                <div class="k">{m.k}</div>
                <div class="v">{m.v}</div>
              </div>
            ))}
          </div>
        </div>
        <ul class="route-steps">
          {r.steps.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  ))
}
