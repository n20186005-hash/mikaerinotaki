---
import type { FaqItem } from '../data/faq';
import { localizeHref, type Locale } from '../i18n/config';
import { L } from '../i18n/types';

interface Props {
  items: FaqItem[];
  locale?: Locale;
}
const { items, locale = 'ja' } = Astro.props;
---
<div class="faq">
  {
    items.map((item, i) => (
      <details open={i === 0}>
        <summary>{L(item.q, locale)}</summary>
        <div class="a" set:html={localizeHref(L(item.a, locale), locale)} />
      </details>
    ))
  }
</div>
