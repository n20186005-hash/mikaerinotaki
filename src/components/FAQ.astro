---
import type { FaqItem } from '../data/faq';
import { localizeHref, type Locale } from '../i18n/config';

interface Props {
  items: FaqItem[];
  locale?: Locale;
}
const { items, locale = 'ja' } = Astro.props;
---
<div class="faq">
  {
    items.map((item, i) => (
      <details open={i === 0}>
        <summary>{item.q}</summary>
        <div class="a" set:html={localizeHref(item.a, locale)} />
      </details>
    ))
  }
</div>
