---
import { audiencePlans, generalPlans } from '../data/strategy';

interface Props {
  id?: string;
}
const { id = 'plans' } = Astro.props;
---

<section class="section alt" id={id}>
  <div class="wrap">
    <p class="eyebrow">Plans by visitor type</p>
    <h2 class="section-title">
      誰と行くかで選ぶ、3つのプラン<span class="h2-en">Plans for families, photographers &amp; low-mobility visitors</span>
    </h2>
    <p class="section-lead" style="margin-bottom:30px">
      同じ滝でも、同行者と体力で歩き方は変わります。出発前に「今日の歩き方」を決めておきましょう。
    </p>

    <div class="grid grid-3">
      {
        audiencePlans.map((p) => (
          <div class="card plan">
            <div class="plan__head">
              <span class="plan__icon" aria-hidden="true">{p.icon}</span>
              <div>
                <h3>{p.title}</h3>
                <p class="plan__audience">{p.audience}</p>
              </div>
            </div>
            <p class="plan__meta">{p.duration} ／ {p.level}</p>
            <ol class="plan__steps">
              {p.steps.map((s) => <li>{s}</li>)}
            </ol>
            <ul class="checklist plan__tips">
              {p.tips.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Recommended itineraries</p>
    <h2 class="section-title">
      推奨モデルルート（半日／一日）<span class="h2-en">Recommended half-day &amp; full-day itineraries</span>
    </h2>
    <div class="grid grid-2" style="margin-top:30px">
      {
        generalPlans.map((g) => (
          <div class="card">
            <h3>{g.icon} {g.title}<span class="plan__meta" style="display:block;margin-top:6px">{g.duration}</span></h3>
            <ul class="route-steps" style="margin-top:14px">{g.steps.map((s) => <li>{s}</li>)}</ul>
            <p style="font-size:.9rem;color:rgba(41,49,46,.8);margin-top:16px">{g.note}</p>
          </div>
        ))
      }
    </div>
    <div style="margin-top:24px"><a class="btn btn--outline" href="/nearby">周辺のモデルコース詳細 →</a></div>
  </div>
</section>
