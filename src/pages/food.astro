---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FoodCard from '../components/FoodCard.astro';
import { nearFalls, karatsuFood } from '../data/food';
import { entity } from '../data/entity';
---
<Base
  title={`${entity.nameWithVariant} 周辺のランチ・食事処｜川魚・豆腐・相知の味`}
  description={`${entity.fullName}（見返りの滝）周辺で食べられるランチをタイプ別に案内。滝そばの川魚料理、相知の豆腐料理、唐津まで足をのばす呼子のイカ・佐賀牛・唐津バーガーまで。営業時間は変わるため事前確認を。`}
  active="/food"
  crumb="周辺グルメ"
>
  <PageHead
    crumb="FOOD"
    title="周辺グルメ"
    lead="滝の周辺は飲食店が多くありません。だからこそ、滝のすぐそばで味わえるお店と、唐津まで足を延ばす“ついでグルメ”を分けてご案内します。"
  />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Near the falls</p>
      <h2 class="section-title">
        滝のすぐそばのランチ<span class="h2-en">Lunch near {entity.fullNameEn} (by type)</span>
      </h2>
      <div class="notice" style="margin-bottom:26px">
        <strong>方針：</strong>当サイトは非営利の解説サイトです。特定の店舗名は紹介せず、
        <strong>「どんな種類の店がどの範囲にあるか」</strong>をまとめています。営業日・営業時間・予約は変わることがあるため、お出かけ前の電話確認がおすすめです。
        <br />{entity.variantNote.ja}
      </div>
      {nearFalls.map((p) => <FoodCard place={p} />)}
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Around Karatsu</p>
      <h2 class="section-title">唐津まで足をのばして</h2>
      <p class="section-lead" style="margin-bottom:28px">滝の帰り道、少し車を走らせれば、唐津エリアを代表するグルメに出会えます。※滝のすぐそばではありません。</p>
      <div class="grid grid-3">
        {karatsuFood.map((f) => (
          <div class="card"><h3>{f.name}</h3><p>{f.desc}</p></div>
        ))}
      </div>
      <div class="notice" style="margin-top:24px"><strong>ヒント：</strong>呼子のイカや佐賀牛の店は滝の近くではありません。「滝のそばで食べられるもの」と「唐津まで行って食べるもの」を分けて計画すると、当日あわてずに済みます。</div>
    </div>
  </section>
</Base>
