---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { stories, kindLabel } from '../data/science';
import type { Story } from '../data/science';

const kindClass: Record<Story['kind'], string> = {
  official: 'official',
  local: 'local',
  editorial: 'editorial',
};
---
<Base
  title="見帰りの滝の歴史・名前の由来・伝説｜石仏とダム、あじさい祭りの歩み"
  description="見帰りの滝の名前の由来と歴史、右岸の石仏、伊岐佐川ダム、あじさい祭りのはじまり、相知の歴史まで。言い伝えと公的記録を区別して紹介します。"
  active="/history"
  crumb="歴史と名前の由来"
>
  <PageHead
    crumb="HISTORY"
    title="歴史と名前の由来"
    lead="「見帰り」という名の物語、滝と相知の暮らし、そしてあじさいの景観がどう生まれたのか。三つの物語からご紹介します。"
  />

  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Story 01</p>
      <h2 class="section-title">なぜ「見帰り」と呼ばれるのか</h2>
      <p class="lead">名前の由来には、いくつかの言い伝えがあります。地元に広く伝わるのは——一度その場を離れても、坂道を戻ってもう一度見たくなるほど美しい、という物語です。</p>
      <p style="color:rgba(41,49,46,.8)">正式な表記は「見帰りの滝」。よく見かける「見返りの滝」は一般的な誤記です。この名の由来は、確定した史実というより、地域に受け継がれてきた物語として語られています。だからこそ、季節ごとに人々が「また見に帰りたい」と足を運んできたのでしょう。</p>
      <p class="notice">この由来は<strong>地域に伝わる言い伝え</strong>としてご紹介しています。</p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap narrow">
      <p class="eyebrow">Story 02</p>
      <h2 class="section-title">滝と、相知の暮らし</h2>
      <p class="lead">見帰りの滝は、佐賀県唐津市相知町、天山県立自然公園の渓谷にあります。水流と岩壁、そして深い森が一体となって、この景観をつくっています。</p>
      <p style="color:rgba(41,49,46,.8)">古くから地域の人々の暮らしとともにあり、やがて相知は、この滝を季節ごとに楽しめる観光地として育ててきました。日本の滝百選にも選ばれ、遠くからも人が訪れる名瀑となっています。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Story 03</p>
      <h2 class="section-title">あじさいの景観は、どう生まれたか</h2>
      <p class="lead">今では滝の代名詞ともいえるあじさい。その景観は、地域の人々が渓谷沿いにあじさいを植え続けてきたことから生まれました。</p>
      <p style="color:rgba(41,49,46,.8)">やがて花は約50種・4万株にまで広がり、毎年6月には「あじさい祭り」が催されるようになりました。滝とあじさいの共演は、人の手と時間が育てた、この土地ならではの風景です。</p>

      <div class="spacer"></div>
      <p class="eyebrow">Timeline</p>
      <h3 style="font-size:1.4rem;margin:0 0 24px">見どころの成り立ち</h3>
      <ul class="timeline">
        <li><span class="yr">古くから</span><span class="tag-src local">言い伝え</span><h3>「見帰り」の名が伝わる</h3><p>美しさに、去ってももう一度見に帰りたくなる——名の由来が語り継がれてきました。</p></li>
        <li><span class="yr">近代以降</span><span class="tag-src official">記録</span><h3>名瀑として知られる</h3><p>渓谷の景観が広く知られ、日本の滝百選に数えられるようになりました。</p></li>
        <li><span class="yr">近年</span><span class="tag-src local">地域の取り組み</span><h3>あじさいの植栽が広がる</h3><p>渓谷沿いのあじさいが育ち、約50種・4万株の景観へ。6月のあじさい祭りが恒例となりました。</p></li>
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Story archive</p>
      <h2 class="section-title">
        物語・伝承・記録<span class="h2-en">Legends, records &amp; local history</span>
      </h2>
      <p class="section-lead" style="margin-bottom:28px">
        史実として確認できること、地域に伝わる物語、編集部が一般的な知見として整理した解説。性格の違いを明示して紹介します。
      </p>
      <div class="grid grid-2">
        {
          stories.map((s) => (
            <article class="card">
              <p class="story__meta">
                <span class="yr">{s.era}</span>
                <span class={`tag-src ${kindClass[s.kind]}`}>{kindLabel[s.kind]}</span>
              </p>
              <h3>{s.title}</h3>
              <p style="color:rgba(41,49,46,.85)">{s.body}</p>
              {s.note && <p class="facility__caution">※ {s.note}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow center">
      <p class="eyebrow" style="justify-content:center">Science</p>
      <h2 class="section-title">地形・水・生きものから見る滝</h2>
      <p class="lead">
        なぜこの場所に落差100mの滝ができたのか。水はどこから来て、どんな生きものが暮らしているのか。
        科学的な背景を知ると、滝の見え方がもう一段深くなります。
      </p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:10px">
        <a class="btn btn--outline" href="/#science">科学で読み解く →</a>
        <a class="btn btn--outline" href="/facilities">施設・サービス →</a>
      </div>
    </div>
  </section>
</Base>
