---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FacilityCard from '../components/FacilityCard.astro';
import { facilityGroups } from '../data/facilities';
import { visitorDuties } from '../data/science';
import { entity } from '../data/entity';
---
<Base
  title={`${entity.fullName} 周辺の施設・サービス｜トイレ・駐車場・飲食・宿泊・給油・EV充電`}
  description={`${entity.fullName}（${entity.city}）周辺のトイレ、駐車場、飲食・宿泊・買い物・給油やEV充電、医療・アクセシビリティを種別ごとに中立的にまとめました。特定の店舗は紹介しません。`}
  active="/facilities"
  crumb="施設・サービス"
>
  <PageHead
    crumb="FACILITIES"
    title="訪客サービスと周辺施設"
    lead="トイレ・駐車場・飲食・宿泊・買い物・給油・EV充電・医療まで。「どんな種類の施設が、どの範囲にあるか」を種別でまとめました。"
  />

  <section class="section">
    <div class="wrap">
      <div class="notice" style="margin-bottom:30px">
        <strong>このページの方針：</strong>当サイトは非営利の解説サイトです。特定の店舗名・施設名は紹介せず、
        <strong>施設の種類と、おおよその範囲・距離感</strong>のみをまとめています。営業状況や台数は変わるため、最新情報は現地の案内・公式情報でご確認ください。
      </div>
      <div class="grid grid-2">
        {facilityGroups.map((g) => <FacilityCard group={g} detailed={true} />)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Etiquette</p>
      <h2 class="section-title">滞在を快適にする心得</h2>
      <div class="grid grid-2" style="margin-top:26px">
        {
          visitorDuties.slice(0, 4).map((d) => (
            <div class="duty">
              <span class="duty__icon" aria-hidden="true">{d.icon}</span>
              <div><h3>{d.title}</h3><p>{d.body}</p></div>
            </div>
          ))
        }
      </div>
      <div style="margin-top:26px">
        <a class="btn btn--outline" href="/access">アクセス・駐車場の詳細 →</a>
        <a class="btn btn--outline" href="/food">食事のタイプ別まとめ →</a>
      </div>
    </div>
  </section>
</Base>
