---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { seasons } from '../data/seasons';
import { climateNote } from '../data/strategy';
import { entity } from '../data/entity';
---
<Base
  title="見帰りの滝の四季｜桜・あじさい・深緑・紅葉の見頃と服装"
  description="見帰りの滝の四季を案内。春の桜、初夏のあじさいと蛍、盛夏の深緑、秋の紅葉、冬の静かな観瀑。季節ごとの見どころ・服装・撮影のコツをまとめました。"
  active="/seasons"
>
  <PageHead
    crumb="SEASONS"
    title="四季の見どころ"
    lead="同じ渓谷が、季節ごとにまったく違う姿を見せます。春の桜、初夏のあじさいと蛍、盛夏の深緑、秋の紅葉、冬の静けさ。服装や撮影のコツもあわせてご紹介します。"
  />

  {
    seasons.map((s, i) => (
      <section class={`section${i % 2 ? ' alt' : ''}`} id={s.id}>
        <div class="wrap">
          <div class={`split${i % 2 ? ' rev' : ''}`}>
            <div class="split__media"><img src={s.img} alt={`${entity.fullName}（${entity.fullNameEn}）— ${s.name}の${s.sub}。${s.chip}の景色`} loading="lazy" /></div>
            <div>
              <span class="scard when">{s.when}</span>
              <h2 class="section-title" style="margin-top:6px">{s.name} — {s.sub}</h2>
              <p class="lead">{s.desc}</p>
              <div class="route-meta" style="margin-top:20px">
                {s.meta.map((m) => (
                  <div>
                    <div class="k">{m.k}</div>
                    <div class="v" style="font-size:.98rem">{m.v}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section alt">
    <div class="wrap narrow">
      <p class="eyebrow">Climate data</p>
      <h2 class="section-title">
        季節の傾向をデータで見る<span class="h2-en">Climate normals &amp; seasonal strategy</span>
      </h2>
      <p class="lead" style="margin-bottom:18px">{climateNote}</p>
      <ul class="checklist">
        <li>渓谷の底にあるため、体感は唐津市街より1〜3℃低くなることがあります</li>
        <li>梅雨期（6〜7月）は降水量が多く、滝の水量が一年で最も増える時期です</li>
        <li>雨の翌日は石段・岩が滑りやすく、増水時は河原へ降りないでください</li>
        <li>数値はあくまで平年値です。出発前に当日の予報をご確認ください</li>
      </ul>
      <div style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn--outline" href="/#weather">今日の天気・週間予報 →</a>
        <a class="btn btn--outline" href="/#strategy">季節ごとの鑑賞戦略 →</a>
        <a class="btn btn--outline" href="/#science">地形と水の科学 →</a>
      </div>
    </div>
  </section>
</Base>
