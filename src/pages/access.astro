---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { accessWays, parking, parkingModes } from '../data/access';
import { fromAirports, publicTransit, taxiGuide, drivingGuide } from '../data/transport';
import { entity } from '../data/entity';
---
<Base
  title={`${entity.nameWithVariant} のアクセス・駐車場｜電車・バス・車・タクシーの行き方`}
  description={`${entity.state}${entity.city}の${entity.fullName}（見返りの滝）への行き方まとめ。唐津IC・多久ICから車、JR相知駅からタクシー、福岡空港・佐賀空港からのルート、駐車場の場所と台数、あじさい祭り期間の交通規制・シャトルまで。`}
  active="/access"
  crumb="アクセス・駐車場"
>
  <PageHead
    crumb="ACCESS"
    title="アクセス・駐車場"
    lead="相知駅・唐津IC・多久ICからの行き方と、駐車場の情報。通常期とあじさい祭り期間で運用が変わる点も整理しました。"
  />

  <section class="section" style="padding-top:clamp(28px,4vw,44px)">
    <div class="wrap">
      <div class="quicknav">
        <a class="btn btn--dark" href={entity.mapsShareUrl} target="_blank" rel="noopener noreferrer">📍 見帰りの滝を地図で開く ↗</a>
        <a class="btn btn--outline" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('見帰りの滝 蛍橋駐車場')}`} target="_blank" rel="noopener noreferrer">🅿️ 蛍橋駐車場へナビ</a>
        <a class="btn btn--outline" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('相知駅')}`} target="_blank" rel="noopener noreferrer">🚉 相知駅へナビ</a>
        <a class="btn btn--outline" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('タクシー 唐津市相知町')}`} target="_blank" rel="noopener noreferrer">🚕 周辺のタクシー</a>
      </div>
      <div class="notice" style="margin-top:18px">
        <strong>名称について：</strong>{entity.variantNote}
        カーナビ・地図アプリは「見帰りの滝」のほか、座標（北緯 {entity.latitude} / 東経 {entity.longitude}）、Plus Code（{entity.plusCode}）でも検索できます。
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">How to get there</p>
      <h2 class="section-title">行き方</h2>
      <div class="grid grid-2" style="margin-top:28px">
        {accessWays.map((w) => (
          <div class="card">
            <div class="ico" aria-hidden="true">{w.icon}</div>
            <h3>{w.title}</h3>
            <ul class="checklist" style="margin-top:6px">
              {w.lines.map((l) => <li>{l}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FROM AIRPORTS -->
  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">From the airport</p>
      <h2 class="section-title">
        空港から見帰りの滝へ<span class="h2-en">From airports to {entity.fullNameEn}</span>
      </h2>
      <p class="section-lead" style="margin-bottom:28px">
        最寄りの空港は福岡空港と佐賀空港（利用の多いのは福岡空港）。いずれも最後は「相知駅 → タクシー」、またはレンタカーになります。
      </p>
      <div class="grid grid-3">
        {
          fromAirports.map((r) => (
            <div class="card">
              <div class="ico" aria-hidden="true">{r.icon}</div>
              <h3>{r.title}</h3>
              <p class="plan__meta">{r.time}</p>
              <ol class="plan__steps">{r.steps.map((s) => <li>{s}</li>)}</ol>
              <ul class="checklist" style="margin-top:14px">{r.tips.map((t) => <li>{t}</li>)}</ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PUBLIC TRANSPORT DETAIL -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Public transport</p>
      <h2 class="section-title">
        公共交通のくわしい使い方<span class="h2-en">Trains, buses &amp; demand transport</span>
      </h2>
      <div class="grid grid-3" style="margin-top:28px">
        {
          publicTransit.map((r) => (
            <div class="card">
              <div class="ico" aria-hidden="true">{r.icon}</div>
              <h3>{r.title}</h3>
              <p class="plan__meta">{r.time}</p>
              <ul class="checklist">{r.steps.map((s) => <li>{s}</li>)}</ul>
              <ul class="checklist" style="margin-top:14px">{r.tips.map((t) => <li>{t}</li>)}</ul>
            </div>
          ))
        }
      </div>
      <div class="notice warn" style="margin-top:24px">
        <strong>公共交通の現実：</strong>このエリアは本数が限られます。時刻表を先に確認し、帰りの手段（終バス・終電・タクシー予約）まで決めてから出発するのが安全です。
      </div>
    </div>
  </section>

  <!-- TAXI -->
  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Taxi</p>
      <h2 class="section-title">
        {taxiGuide.title}<span class="h2-en">Last few kilometres by taxi</span>
      </h2>
      <p class="section-lead" style="margin-bottom:24px">{taxiGuide.lead}</p>
      <div class="split">
        <ul class="checklist">
          {taxiGuide.points.map((p) => <li>{p}</li>)}
        </ul>
        <div class="notice"><strong>ご注意：</strong>{taxiGuide.caution}</div>
      </div>
      <div style="margin-top:24px">
        <a class="btn btn--outline" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('タクシー 唐津市相知町')}`} target="_blank" rel="noopener">
          相知周辺のタクシーを地図で探す ↗
        </a>
      </div>
    </div>
  </section>

  <!-- DRIVING -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Driving</p>
      <h2 class="section-title">
        {drivingGuide.title}<span class="h2-en">Driving routes &amp; road notes</span>
      </h2>
      <div class="table-wrap" style="margin-top:26px">
        <table>
          <thead><tr><th>出発地</th><th>距離・所要時間の目安</th></tr></thead>
          <tbody>
            {drivingGuide.routes.map((r) => <tr><td>{r.k}</td><td>{r.v}</td></tr>)}
          </tbody>
        </table>
      </div>
      <ul class="checklist" style="margin-top:22px">
        {drivingGuide.points.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Parking</p>
      <h2 class="section-title">駐車場</h2>
      <p class="section-lead" style="margin-bottom:26px">滝の周辺には、普通車あわせて約50台の駐車スペースがあります。場所ごとの目安は次のとおりです。</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>駐車場</th><th>普通車</th><th>大型車</th><th>滝までの目安</th></tr></thead>
          <tbody>
            {parking.map((p) => (
              <tr><td>{p.name}</td><td class="en">{p.car}</td><td class="en">{p.bus}</td><td>{p.note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="font-size:.84rem;color:rgba(41,49,46,.6);margin-top:12px">※台数は目安です。あじさい祭り期間は運用が変わります。</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Two modes</p>
      <h2 class="section-title">通常期と、あじさい祭り期間</h2>
      <div class="grid grid-2" style="margin-top:28px">
        <div class="card">
          <h3>{parkingModes.normal.icon} {parkingModes.normal.title}</h3>
          <p style="margin-bottom:14px">{parkingModes.normal.desc}</p>
          <ul class="checklist">{parkingModes.normal.points.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="card" style="border-color:rgba(139,118,156,.35)">
          <h3>{parkingModes.festival.icon} {parkingModes.festival.title}</h3>
          <p style="margin-bottom:14px">{parkingModes.festival.desc}</p>
          <ul class="checklist">{parkingModes.festival.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      </div>
      <div class="notice warn" style="margin-top:24px"><strong>ご注意：</strong>あじさい祭りの交通ルールは年ごとに異なります。ある年の情報をそのまま当てにせず、お出かけ前に最新の案内をご確認ください。</div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap narrow center">
      <p class="eyebrow" style="justify-content:center">Navigate</p>
      <h2 class="section-title">
        地図アプリで開く<span class="h2-en">Location &amp; How to Visit {entity.shortName} in {entity.cityEn}</span>
      </h2>
      <p class="section-lead" style="margin-inline:auto;margin-bottom:24px">目的地を選んで、お使いの地図アプリでルート案内を開始できます。</p>
      <div class="loc__map" style="margin-bottom:26px">
        <iframe
          src={entity.mapsEmbedSrc}
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title={`${entity.fullName}（${entity.fullNameEn}）へのアクセスマップ`}></iframe>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
        <a class="btn btn--dark" href="https://www.google.com/maps/search/?api=1&query=見帰りの滝+蛍橋駐車場" target="_blank" rel="noopener">蛍橋駐車場へ</a>
        <a class="btn btn--outline" href="https://www.google.com/maps/search/?api=1&query=見帰りの滝+清流荘" target="_blank" rel="noopener">上流の駐車エリアへ</a>
        <a class="btn btn--outline" href="https://www.google.com/maps/search/?api=1&query=相知駅" target="_blank" rel="noopener">相知駅へ</a>
      </div>
      <p style="margin-top:26px"><a class="btn btn--primary" href="/walk" style="background:var(--forest);color:#fff">到着後の散策ルートを見る →</a></p>
      <p style="margin-top:22px;font-size:.86rem;color:rgba(41,49,46,.75)">
        所在地：〒{entity.postalCode} {entity.state}{entity.city}{entity.streetAddress}（北緯 {entity.latitude} / 東経 {entity.longitude}）／
        For official updates, visit
        <a href={entity.govtTourismUrl} target="_blank" rel="noopener noreferrer">{entity.stateEn} / {entity.cityEn} Official Tourism Portal</a>.
      </p>
    </div>
  </section>
</Base>
