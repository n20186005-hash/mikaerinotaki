---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FAQ from '../components/FAQ.astro';
import { faqs } from '../data/faq';
import { entity } from '../data/entity';
---
<Base
  title={`${entity.nameWithVariant} よくある質問｜料金・滞在時間・駐車場・ペット`}
  description={`${entity.fullName}（見返りの滝）の疑問にまとめて回答。入場は無料？滞在時間の目安？ベビーカーやペットは大丈夫？あじさいの見頃、雨の日、夜のライトアップ、公共交通での行き方まで。`}
  active="/faq"
  faqs={faqs}
  crumb="よくある質問"
>
  <PageHead
    crumb="FAQ"
    title="よくある質問"
    lead="料金、見頃、歩きやすさ、駐車場、雨の日、ペット、ライトアップまで。見帰りの滝を訪れる前の疑問にお答えします。"
  />

  <section class="section">
    <div class="wrap narrow">
      <FAQ items={faqs} />
      <div class="spacer"></div>
      <div class="notice">まだ疑問が残る場合は、<a href="/access">アクセス</a>・<a href="/ajisai">あじさい</a>・<a href="/walk">散策ルート</a>の各ページもあわせてご覧ください。</div>
    </div>
  </section>
</Base>
