---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import RouteMap from '../components/RouteMap.astro';
import RouteDetail from '../components/RouteDetail.astro';
import { routes } from '../data/routes';

const walkRoutes = routes.filter((r) => r.id !== 'rhd');
---
<Base
  title="見帰りの滝の散策ルート・マップ｜所要時間・階段・ベビーカー"
  description="見帰りの滝の散策マップと3つのルート(クイック観瀑・標準渓谷・撮影)を案内。所要時間、歩行量、階段、ベビーカー可否、雨後の注意までまとめました。"
  active="/walk"
>
  <PageHead
    crumb="WALK"
    title="散策ルート・マップ"
    lead="駐車場・遊歩道・川・橋・滝・トイレ・撮影スポットの位置を一枚に。目的に合わせて、3つのルートから選べます。"
  />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Trail map</p>
      <h2 class="section-title">散策マップ(模式図)</h2>
      <p class="section-lead" style="margin-bottom:24px">全体の位置関係をつかむための簡易マップです。実際のルート案内は、地図アプリをご利用ください。</p>
      <RouteMap />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Choose a route</p>
      <h2 class="section-title">3つの散策ルート</h2>
      <div style="margin-top:28px">
        {walkRoutes.map((r) => <RouteDetail route={r} />)}
      </div>
      <div style="margin-top:8px"><a class="btn btn--outline" href="/photo">撮影スポットの詳細 →</a></div>
    </div>
  </section>
</Base>
