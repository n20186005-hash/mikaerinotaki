# Cloudflare（Workers 靜態資產 / Pages）用のレスポンスヘッダー
# 手動デプロイ時に dist 直下へコピーされます。

# 全ページ共通：HTTP→HTTPS の正規化を強制（HSTS）
https://mikaerinotaki.com/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# 画像：長期キャッシュ
https://mikaerinotaki.com/images/*
  Cache-Control: public, max-age=31536000, immutable

https://mikaerinotaki.com/icons/*
  Cache-Control: public, max-age=31536000, immutable

# ビルド成果物（ハッシュ付き）：長期キャッシュ
https://mikaerinotaki.com/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker は必ず最新を読ませる
https://mikaerinotaki.com/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

# manifest / オフラインページ
https://mikaerinotaki.com/manifest.webmanifest
  Cache-Control: public, max-age=3600

https://mikaerinotaki.com/offline.html
  Cache-Control: public, max-age=3600
